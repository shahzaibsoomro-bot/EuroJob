function buildInitialVerifiedFeed(totalCount = 5040): Job[] {
  const shifts = ['Day Shift', 'International Route', 'Senior', 'Shift A', 'Relocation Batch', 'Express Visa'];
  const list: Job[] = [];
  for (let i = 0; i < totalCount; i++) {
    const base = BASE_TEMPLATES[i % BASE_TEMPLATES.length];
    const batch = Math.floor(i / BASE_TEMPLATES.length);
    list.push({
      ...base,
      id: `eu-job-${i + 1}`,
      title: batch === 0 ? base.title : `${base.title} (${shifts[batch % shifts.length]} #${batch + 1})`
    });
  }
  return list;
}

