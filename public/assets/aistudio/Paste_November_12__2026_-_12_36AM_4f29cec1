            </div>
          </div>
        </section>
      )}

      {/* ====================================================================
          UPGRADE / RENEW PRO ($5/MONTH) PAYMENT MODAL
      ==================================================================== */}
      {showUpgradeModal && (
        <div className="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-white rounded-3xl max-w-xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 my-8">
            <div className="flex items-center justify-between pb-4 border-b border-slate-100">
              <div>
                <span className="text-xs font-extrabold text-purple-600 uppercase">
                  EUROJOB PRO MEMBERSHIP — $5 / MONTH (30 DAYS)
                </span>
                <h3 className="text-xl font-extrabold text-slate-900">
                  Unlock Unlimited EU Jobs, AI % Score & Europass CV PDF
                </h3>
              </div>
              <button onClick={() => setShowUpgradeModal(false)}>
                <X className="w-5 h-5 text-slate-400 hover:text-slate-700" />
              </button>
            </div>

            {paySubmittedSuccess ? (
              <div className="py-10 text-center space-y-3">
                <CheckCircle2 className="w-14 h-14 text-emerald-500 mx-auto" />
                <h4 className="text-xl font-extrabold text-slate-900">
                  Payment Screenshot Submitted!
                </h4>
                <p className="text-sm text-slate-600 max-w-md mx-auto">
                  Your payment proof has been sent to the EUROJOB Admin Dashboard. Your account will be activated for <strong>30 days</strong> within <strong>24 hours</strong> and you will receive a Congratulations notification.
                </p>
                <button
                  onClick={() => setShowUpgradeModal(false)}
                  className="mt-4 bg-blue-700 text-white font-bold px-6 py-2.5 rounded-xl text-sm"
                >
                  Return to EUROJOB
                </button>
              </div>
            ) : (
              <div className="mt-5 space-y-5">
                <div className="grid grid-cols-2 gap-2 bg-slate-100 p-1 rounded-2xl">
                  <button
                    type="button"
                    onClick={() => setPaymentTab('easypaisa')}
                    className={`py-2.5 rounded-xl text-xs font-extrabold transition ${
                      paymentTab === 'easypaisa'
                        ? 'bg-emerald-600 text-white shadow'
                        : 'text-slate-700 hover:text-slate-900'
                    }`}
                  >
                    Easypaisa (Local Pakistan)
                  </button>
                  <button
                    type="button"
                    onClick={() => setPaymentTab('ach')}
                    className={`py-2.5 rounded-xl text-xs font-extrabold transition ${
                      paymentTab === 'ach'
                        ? 'bg-blue-800 text-white shadow'
                        : 'text-slate-700 hover:text-slate-900'
                    }`}
                  >
                    ACH Bank Transfer (International)
                  </button>
                </div>

                {paymentTab === 'easypaisa' ? (
                  <div className="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 space-y-2 text-xs">
                    <div className="flex justify-between items-center">
                      <span className="text-emerald-800 font-semibold">Account Name:</span>
                      <span className="font-extrabold text-slate-900 text-sm">{paymentConfig.easypaisaName}</span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-emerald-800 font-semibold">Easypaisa Account Number:</span>
                      <div className="flex items-center gap-2">
                        <span className="font-extrabold text-slate-900 text-sm">{paymentConfig.easypaisaNumber}</span>
                        <button
                          type="button"
                          onClick={() => handleCopy(paymentConfig.easypaisaNumber, 'ep')}
                          className="bg-emerald-600 text-white px-2 py-0.5 rounded text-[11px] font-bold"
                        >
                          {copiedField === 'ep' ? 'Copied' : 'Copy'}
                        </button>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-emerald-800 font-semibold">Transfer Purpose:</span>
                      <span className="font-extrabold text-emerald-900 bg-emerald-200/70 px-2.5 py-0.5 rounded">
                        {paymentConfig.easypaisaPurpose}
                      </span>
                    </div>
                    <div className="flex justify-between items-center pt-1 border-t border-emerald-200">
                      <span className="text-emerald-800 font-semibold">Amount Payable:</span>
                      <span className="font-extrabold text-slate-900">{paymentConfig.easypaisaPkrAmount}</span>
                    </div>
                  </div>
                ) : (
                  <div className="p-4 rounded-2xl bg-blue-50 border border-blue-200 space-y-2 text-xs">
                    <div className="flex justify-between items-center">
                      <span className="text-blue-800 font-semibold">Account Name:</span>
                      <span className="font-extrabold text-slate-900">{paymentConfig.achAccountName}</span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-blue-800 font-semibold">Bank Name:</span>
                      <span className="font-extrabold text-slate-900">{paymentConfig.achBankName}</span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-blue-800 font-semibold">Account Number:</span>
                      <div className="flex items-center gap-2">
                        <span className="font-extrabold text-slate-900">{paymentConfig.achAccountNumber}</span>
                        <button
                          type="button"
                          onClick={() => handleCopy(paymentConfig.achAccountNumber, 'ach-acc')}
                          className="bg-blue-700 text-white px-2 py-0.5 rounded text-[11px] font-bold"
                        >
                          {copiedField === 'ach-acc' ? 'Copied' : 'Copy'}
                        </button>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-blue-800 font-semibold">Routing Number:</span>
                      <div className="flex items-center gap-2">
                        <span className="font-extrabold text-slate-900">{paymentConfig.achRoutingNumber}</span>
                        <button
                          type="button"
                          onClick={() => handleCopy(paymentConfig.achRoutingNumber, 'ach-rt')}
                          className="bg-blue-700 text-white px-2 py-0.5 rounded text-[11px] font-bold"
                        >
                          {copiedField === 'ach-rt' ? 'Copied' : 'Copy'}
                        </button>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-blue-800 font-semibold">Account Type:</span>
                      <span className="font-extrabold text-slate-900">{paymentConfig.achAccountType}</span>
                    </div>
                    <div className="flex justify-between items-center pt-1 border-t border-blue-200">
                      <span className="text-blue-800 font-semibold">Amount Payable:</span>
                      <span className="font-extrabold text-slate-900">{paymentConfig.achUsdAmount}</span>
                    </div>
                  </div>
                )}

                <div className="p-3.5 rounded-2xl bg-amber-50 border border-amber-300 flex items-start gap-2.5 text-xs text-amber-950">
                  <AlertTriangle className="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
                  <p>
                    <strong>MANDATORY NOTICE:</strong> Enter the exact <strong>signed-up EUROJOB email</strong> on which you want PRO activated. If an unregistered / non-signed-up email is submitted, PRO cannot be activated and the paid amount is strictly <strong>NON-REFUNDABLE</strong>. Verification takes up to <strong>24 hours</strong>.
                  </p>
                </div>

                <form onSubmit={handleSubmitPaymentProof} className="space-y-3">
                  <div>
                    <label className="block text-xs font-bold text-slate-700 mb-1">
                      Registered Email Address to Activate PRO *
                    </label>
                    <input
                      type="email"
                      required
                      value={payTargetEmail}
                      onChange={(e) => setPayTargetEmail(e.target.value)}
                      placeholder="your.signedup.email@gmail.com"
                      className="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-bold text-slate-700 mb-1">
                      Transaction ID / Reference Number *
                    </label>
                    <input
                      type="text"
                      required
                      value={payTxId}
                      onChange={(e) => setPayTxId(e.target.value)}
                      placeholder="e.g. EP-98432104 or ACH Reference ID"
                      className="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-bold text-slate-700 mb-1">
                      Upload Payment Proof Screenshot *
                    </label>
                    <label className="flex flex-col items-center justify-center border-2 border-dashed border-slate-300 hover:border-blue-500 rounded-2xl p-4 cursor-pointer bg-slate-50">
                      <Upload className="w-6 h-6 text-blue-600 mb-1" />
                      <span className="text-xs font-semibold text-slate-700">
                        {payScreenshot ? 'Screenshot Attached ✓ (Click to change)' : 'Click to upload receipt screenshot (PNG/JPG)'}
                      </span>
                      <input type="file" accept="image/*" required onChange={handleScreenshotUpload} className="hidden" />
                    </label>
                    {payScreenshot && (
                      <img src={payScreenshot} alt="Preview" className="mt-2 h-24 rounded-xl border border-slate-200 object-cover" />
                    )}
                  </div>

                  <button
                    type="submit"
                    className="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-xl shadow-lg transition text-sm"
                  >
                    Submit Payment Proof (Activate Within 24 Hours)
                  </button>
                </form>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Receipt Image Preview Modal */}
      {previewReceiptUrl && (
        <div
          onClick={() => setPreviewReceiptUrl(null)}
          className="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4"
        >
          <div className="bg-white p-3 rounded-2xl max-w-lg w-full">
            <img src={previewReceiptUrl} alt="Payment Receipt" className="w-full rounded-xl" />
            <button
              onClick={() => setPreviewReceiptUrl(null)}
              className="mt-3 w-full bg-slate-900 text-white py-2 rounded-xl text-xs font-bold"
            >
              Close Preview
            </button>
          </div>
        </div>
      )}

      {/* Signup / Login Modal */}
      {showAuthModal && (
        <div className="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-200">
            <div className="flex items-center justify-between pb-4 border-b border-slate-100">
              <h3 className="text-xl font-extrabold text-slate-900">
                {authMode === 'signup' ? 'Create Free EUROJOB Account' : 'Welcome Back to EUROJOB'}
              </h3>
              <button onClick={() => setShowAuthModal(false)}>
                <X className="w-5 h-5 text-slate-400" />
              </button>
            </div>

            <div className="mt-5 space-y-4">
              <button
                type="button"
                onClick={() => handleAuthSubmit('Google')}
                className="w-full flex items-center justify-center gap-2.5 bg-white hover:bg-slate-50 text-slate-900 font-bold py-2.5 px-4 rounded-xl border border-slate-300 shadow-sm text-sm transition"
              >
                <Globe className="w-4 h-4 text-blue-600" />
                Continue with Google
              </button>

              <div className="relative text-center text-xs text-slate-400">
                <span className="bg-white px-2 relative z-10">or sign up with Email</span>
                <div className="border-t border-slate-200 absolute inset-x-0 top-1/2" />
              </div>

              <div className="space-y-3">
                {authMode === 'signup' && (
                  <input
                    type="text"
                    value={authName}
                    onChange={(e) => setAuthName(e.target.value)}
                    placeholder="Full Name (as on Passport)"
                    className="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300"
                  />
                )}
                <input
                  type="email"
                  value={authEmail}
                  onChange={(e) => setAuthEmail(e.target.value)}
                  placeholder="Email Address"
                  className="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300"
                />
                {authMode === 'signup' && (
                  <div className="grid grid-cols-2 gap-2">
                    <select
                      value={authNationality}
                      onChange={(e) => setAuthNationality(e.target.value)}
                      className="px-3 py-2.5 text-xs rounded-xl border border-slate-300"
                    >
                      <option>Pakistan</option>
                      <option>India</option>
                      <option>Bangladesh</option>
                      <option>Nepal</option>
                      <option>Philippines</option>
                      <option>Sri Lanka</option>
                    </select>
                    <select
                      value={authTrade}
                      onChange={(e) => setAuthTrade(e.target.value as JobCategory)}
                      className="px-3 py-2.5 text-xs rounded-xl border border-slate-300"
                    >
                      <option value="Tech & IT">Tech & IT</option>
                      <option value="Truck & Logistics">Truck & Logistics</option>
                      <option value="General Labor & Construction">General Labor</option>
                      <option value="Agriculture & Farming">Agriculture</option>
                    </select>
                  </div>
                )}

                <button
                  type="button"
                  onClick={() => handleAuthSubmit('Email')}
                  className="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm shadow"
                >
                  {authMode === 'signup' ? 'Create Account (5 Free Applications)' : 'Login'}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Floating AI Helpcenter Chatbot */}
      <div className="fixed bottom-5 right-5 z-40">
        {chatOpen ? (
          <div className="w-80 sm:w-96 bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col">
            <div className="bg-[#0F172A] text-white px-4 py-3.5 flex items-center justify-between">
              <div className="flex items-center gap-2">
                <Sparkles className="w-4 h-4 text-blue-400" />
                <span className="font-bold text-sm">EUROJOB AI Helpcenter</span>
              </div>
              <button onClick={() => setChatOpen(false)}>
                <X className="w-4 h-4 text-slate-400 hover:text-white" />
              </button>
            </div>
            <div className="p-4 h-72 overflow-y-auto space-y-3 bg-slate-50">
              {chatMessages.map((m, idx) => (
                <div
                  key={idx}
                  className={`p-3 rounded-2xl text-xs leading-relaxed ${
                    m.role === 'user'
                      ? 'bg-blue-700 text-white ml-8'
                      : 'bg-white text-slate-800 border border-slate-200 mr-6'
                  }`}
                >
                  {m.text}
                </div>
              ))}
            </div>
            <form onSubmit={handleSendChat} className="p-2.5 bg-white border-t border-slate-200 flex gap-2">
              <input
                type="text"
                value={chatInput}
                onChange={(e) => setChatInput(e.target.value)}
                placeholder="Ask about visas, jobs, Pro..."
                className="flex-1 text-xs px-3 py-2 rounded-xl bg-slate-100 focus:outline-none"
              />
              <button
                type="submit"
                className="bg-blue-700 hover:bg-blue-800 text-white p-2 rounded-xl"
              >
                <Send className="w-4 h-4" />
              </button>
            </form>
          </div>
        ) : (
          <button
            onClick={() => setChatOpen(true)}
            className="flex items-center gap-2 bg-[#0F172A] hover:bg-blue-900 text-white px-4 py-3 rounded-full shadow-xl border border-blue-500/40 text-xs font-bold transition"
          >
            <MessageSquare className="w-4 h-4 text-blue-400" />
            AI Helpcenter
          </button>
        )}
      </div>
    </div>
  );
}