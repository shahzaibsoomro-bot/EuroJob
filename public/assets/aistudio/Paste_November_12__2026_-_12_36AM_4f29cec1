// ============================================================================
// HELPER: CALCULATE DAYS REMAINING ON PRO SUBSCRIPTION
// ============================================================================
const MS_PER_DAY = 1000 * 60 * 60 * 24;

function getRemainingProDays(proExpiresAt?: number | null): number {
  if (!proExpiresAt) return 0;
  const diff = proExpiresAt - Date.now();
  return diff <= 0 ? 0 : Math.ceil(diff / MS_PER_DAY);
}

