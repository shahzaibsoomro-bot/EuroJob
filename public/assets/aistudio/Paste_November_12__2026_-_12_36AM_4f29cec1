            } else if (titleLower.includes('worker') || titleLower.includes('technician') || titleLower.includes('welder')) {
              autoCategory = 'General Labor & Construction';
            }
            liveFetched.push({
              id: `api-${pIdx}-${item.slug || idx}-${Date.now()}`,
              title: item.title,
              company: item.company_name || 'European Employer',
              country: item.location?.includes('Berlin') || item.location?.includes('Munich') ? 'Germany' : 'Netherlands',
              city: item.location || 'Berlin / Remote EU',
              category: autoCategory,
              salary: '€3,500 – €5,800 / month',
              visaSponsored: true,
              postedAt: 'Live API Sync',
              source: 'Arbeitnow API',
              description: (item.description || '').replace(/<[^>]*>?/gm, '').slice(0, 320) + '...',
              requirements: ['Valid Passport', 'English or Local EU Language', 'Relevant Trade/Tech Experience']
            });
          });
        }
      });

      if (liveFetched.length > 0) {
        setJobs((prev) => [...liveFetched, ...prev]);
        setSelectedJob(liveFetched[0]);
      }
    } finally {
      setIsSyncingApi(false);
    }
  };

  // Handle Signup / Login
  const handleAuthSubmit = (provider: 'Google' | 'Email') => {
    const emailToUse =
      provider === 'Google' && !authEmail
        ? ADMIN_EMAIL
        : authEmail.trim().toLowerCase();

    if (!emailToUse) return;

    const existing = users.find((u) => u.email.toLowerCase() === emailToUse);
    if (existing) {
      setCurrentUserEmail(existing.email);
      setShowAuthModal(false);
      return;
    }

    const newUser: UserAccount = {
      id: `user-${Date.now()}`,
      name: authName.trim() || (provider === 'Google' ? 'Google Applicant' : emailToUse.split('@')[0]),
      email: emailToUse,
      authProvider: provider,
      nationality: authNationality,
      trade: authTrade,
      experienceYears: 3,
      skills: 'European Standard Safety, English Communication, Trade Certification',
      hasPassport: true,
      hasLicenseOrCert: true,
      isPro: false,
      proExpiresAt: null,
      applicationsUsed: 0,
      appliedJobIds: []
    };

    setUsers((prev) => [newUser, ...prev]);
    setCurrentUserEmail(newUser.email);
    setShowAuthModal(false);
  };

  // Handle Apply to Job (Enforces 5-Job Free Limit)
  const handleApplyJob = (job: Job) => {
    if (!currentUser) {
      setAuthMode('signup');
      setShowAuthModal(true);
      return;
    }

    if (currentUser.appliedJobIds.includes(job.id)) return;

    if (!currentUser.isPro && currentUser.applicationsUsed >= 5) {
      setPaySubmittedSuccess(false);
      setShowUpgradeModal(true);
      return;
    }

    setUsers((prev) =>
      prev.map((u) =>
        u.email === currentUser.email
          ? {
              ...u,
              applicationsUsed: u.applicationsUsed + 1,
              appliedJobIds: [...u.appliedJobIds, job.id]
            }
          : u
      )
    );
  };

  // Handle Screenshot Upload
  const handleScreenshotUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onloadend = () => {
      setPayScreenshot(reader.result as string);
    };
    reader.readAsDataURL(file);
  };

  // Submit Payment Proof
  const handleSubmitPaymentProof = (e: React.FormEvent) => {
    e.preventDefault();
    if (!payTargetEmail.trim() || !payTxId.trim() || !payScreenshot) return;

    const newSubmission: PaymentSubmission = {
      id: `pay-${Date.now()}`,
      targetEmail: payTargetEmail.trim().toLowerCase(),
      method: paymentTab === 'easypaisa' ? 'Easypaisa' : 'ACH Bank Transfer',
      transactionId: payTxId.trim(),
      screenshotUrl: payScreenshot,
      submittedAt: new Date().toLocaleString(),
      status: 'Pending'
    };

    setPaymentSubmissions((prev) => [newSubmission, ...prev]);
    setPaySubmittedSuccess(true);
    setPayTxId('');
    setPayScreenshot('');
  };

  // Admin 1-Click Activate & Deactivate PRO
  const activateUserPro = (targetEmail: string, submissionId?: string) => {
    const matchedUser = users.find(
      (u) => u.email.toLowerCase() === targetEmail.toLowerCase()
    );
    if (!matchedUser) {
      alert('Cannot activate: This email is NOT signed up on EUROJOB (Non-Refundable Policy).');
      return;
    }

    const thirtyDaysFromNow = Date.now() + 30 * MS_PER_DAY;

    setUsers((prev) =>
      prev.map((u) =>
        u.email.toLowerCase() === targetEmail.toLowerCase()
          ? {
              ...u,
              isPro: true,
              proExpiresAt: thirtyDaysFromNow,
              threeDayWarnedForCycle: false,
              showCongratsModal: true
            }
          : u
      )
    );

    if (submissionId) {
      setPaymentSubmissions((prev) =>
        prev.map((p) => (p.id === submissionId ? { ...p, status: 'Approved' } : p))
      );
    }

    setNotifications((prev) => [
      {
        id: `notif-act-${Date.now()}`,
        userEmail: matchedUser.email,
        title: '🎉 Congratulations! EUROJOB PRO Activated (30 Days)',
        message:
          'Your $5/month Pro membership is now active for 30 days! Your profile glows with the Purple PRO badge, unlimited European job applications, AI Acceptance Scores, and the Europass Resume & Cover Letter PDF Builder are unlocked.',
        type: 'success',
        createdAt: 'Just now',
        read: false
      },
      ...prev
    ]);
  };

  const deactivateUserPro = (targetEmail: string) => {
    const matchedUser = users.find(
      (u) => u.email.toLowerCase() === targetEmail.toLowerCase()
    );
    if (!matchedUser) return;

    setUsers((prev) =>
      prev.map((u) =>
        u.email.toLowerCase() === targetEmail.toLowerCase()
          ? {
              ...u,
              isPro: false,
              proExpiresAt: null,
              threeDayWarnedForCycle: false,
              showCongratsModal: false
            }
          : u
      )
    );

    setNotifications((prev) => [
      {
        id: `notif-deact-${Date.now()}`,
        userEmail: matchedUser.email,
        title: 'EUROJOB PRO Subscription Deactivated',
        message:
          'Your Pro membership has been deactivated by the administrator and your account has returned to the Free plan (5 applications limit). You can reactivate anytime from Upgrade to Pro.',
        type: 'warning',
        createdAt: 'Just now',
        read: false
      },
      ...prev
    ]);
  };

  // Calculate AI Acceptance Percentage
  const calculateAcceptanceScore = (user: UserAccount, job: Job) => {
    let score = 62;
    if (user.trade === job.category) score += 18;
    if (user.hasPassport) score += 8;
    if (user.hasLicenseOrCert) score += 7;
    if (user.experienceYears >= 3) score += 4;
    return Math.min(score, 98);
  };

  // Admin Manual Add Job
  const handleAdminAddJob = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newJobTitle || !newJobCompany) return;
    const created: Job = {
      id: `job-admin-${Date.now()}`,
      title: newJobTitle,
      company: newJobCompany,
      country: newJobCountry,
      city: newJobCity || newJobCountry,
      category: newJobCategory,
      salary: newJobSalary || '€2,400 / month',
      visaSponsored: true,
      postedAt: 'Just now',
      source: 'EUROJOB Verified',
      description: newJobDesc || 'Verified European employer accepting international Asian applicants with visa sponsorship.',
      requirements: ['Valid Passport', 'Relevant Trade Experience', 'Clean Background Check']
    };
    setJobs((prev) => [created, ...prev]);
    setNewJobTitle('');
    setNewJobCompany('');
    setNewJobCity('');
    setNewJobSalary('');
    setNewJobDesc('');
  };

  // Chatbot Reply Logic
  const handleSendChat = (e: React.FormEvent) => {
    e.preventDefault();
    if (!chatInput.trim()) return;
    const q = chatInput.trim();
    setChatMessages((prev) => [...prev, { role: 'user', text: q }]);
    setChatInput('');

    setTimeout(() => {
      const lower = q.toLowerCase();
      let reply =
        'To apply for European jobs on EUROJOB: (1) Sign up with Google or Email, (2) Apply up to 5 jobs free, or upgrade to Pro ($5/mo via Easypaisa or Cross River Bank ACH) for unlimited applications, AI Acceptance Scores, and PDF Europass CVs.';
      if (lower.includes('germany') || lower.includes('truck')) {
        reply =
          'For Germany & EU Truck Driving (CE License): Employers require a valid heavy vehicle license, 18+ months passport validity, and basic English. Once hired, employers issue a Vorabzustimmung for fast embassy work-visa stamping.';
      } else if (lower.includes('malta') || lower.includes('lithuania') || lower.includes('serbia')) {
        reply =
          'Malta, Lithuania, and Serbia are currently the fastest European destinations for Asian workers in Hospitality, Construction, Warehouse, and Driving—typically taking 6 to 10 weeks for work permit approval.';
      } else if (lower.includes('pay') || lower.includes('easypaisa') || lower.includes('pro')) {
        reply =
          'Click "Upgrade Pro ($5/mo)" in the top bar. Pay locally via Easypaisa (SHAH ZAIB SOOMRO — 03003608184) or internationally via Cross River Bank ACH, upload your screenshot, and get activated within 24 hours!';
      }
      setChatMessages((prev) => [...prev, { role: 'bot', text: reply }]);
    }, 450);
  };

  const userNotifications = useMemo(
    () => notifications.filter((n) => n.userEmail.toLowerCase() === currentUser?.email.toLowerCase()),
    [notifications, currentUser]
  );
  const unreadCount = userNotifications.filter((n) => !n.read).length;
  const currentUserDaysLeft = getRemainingProDays(currentUser?.proExpiresAt);
  const selectedStudioJob = useMemo(
    () => jobs.find((j) => j.id === studioJobId) || jobs[0],
    [jobs, studioJobId]
  );

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 font-sans">
      {/* ====================================================================
          TOP NAVIGATION BAR (NAVY & ROYAL BLUE THEME)
      ==================================================================== */}
      <header className="sticky top-0 z-40 bg-[#0F172A] text-white border-b border-slate-800 shadow-md">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          {/* Brand Logo */}
          <div className="flex items-center gap-3 cursor-pointer" onClick={() => setActiveTab('jobs')}>
            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow-lg">
              <Globe className="w-6 h-6 text-white" />
            </div>
            <div>
              <span className="text-xl font-extrabold tracking-tight text-white">
                EURO<span className="text-blue-400">JOB</span>
              </span>
              <span className="hidden sm:block text-[10px] uppercase tracking-widest text-blue-300 font-semibold">
                Europe Careers for Asia
              </span>
            </div>
          </div>

          {/* Primary Nav Tabs */}
          <nav className="hidden md:flex items-center gap-1 bg-slate-900/80 p-1 rounded-xl border border-slate-800">
            <button
              onClick={() => setActiveTab('jobs')}
              className={`px-3.5 py-1.5 rounded-lg text-sm font-medium transition ${
                activeTab === 'jobs' ? 'bg-blue-600 text-white' : 'text-slate-300 hover:text-white'
              }`}
            >
              Find EU Jobs ({jobs.length.toLocaleString()})
            </button>
            <button
              onClick={() => setActiveTab('career-studio')}
              className={`px-3.5 py-1.5 rounded-lg text-sm font-medium flex items-center gap-1.5 transition ${
                activeTab === 'career-studio' ? 'bg-blue-600 text-white' : 'text-slate-300 hover:text-white'
              }`}
            >
              <Sparkles className="w-4 h-4 text-purple-400" />
              AI CV & Cover Letter
            </button>
            <button
              onClick={() => setActiveTab('discussions')}
              className={`px-3.5 py-1.5 rounded-lg text-sm font-medium transition ${
                activeTab === 'discussions' ? 'bg-blue-600 text-white' : 'text-slate-300 hover:text-white'
              }`}
            >
              Discussions
            </button>

            {/* STRICTLY VISIBLE ONLY TO shahzaibs189@gmail.com */}
            {isAdmin && (
              <button
                onClick={() => setActiveTab('admin')}
                className={`px-3.5 py-1.5 rounded-lg text-sm font-medium flex items-center gap-1.5 transition ${
                  activeTab === 'admin' ? 'bg-blue-600 text-white' : 'text-amber-300 hover:text-amber-200'
                }`}
              >
                <LayoutDashboard className="w-4 h-4" />
                Owner Dashboard
              </button>
            )}
          </nav>

          {/* Right User Controls */}
          <div className="flex items-center gap-3">
            {(!currentUser || !currentUser.isPro || currentUserDaysLeft <= 3) && (
              <button
                onClick={() => {
                  setPaySubmittedSuccess(false);
                  setShowUpgradeModal(true);
                }}
                className="hidden sm:flex items-center gap-1.5 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white text-xs font-bold px-3.5 py-2 rounded-full shadow-md transition"
              >
                <Crown className="w-3.5 h-3.5" />
                {currentUser?.isPro ? `Renew PRO (${currentUserDaysLeft}d left)` : 'Upgrade Pro ($5/mo)'}
              </button>
            )}

            {/* Notification Bell */}
            {currentUser && (
              <div className="relative">
                <button
                  onClick={() => {
                    setShowNotifDropdown(!showNotifDropdown);
                    setNotifications((prev) =>
                      prev.map((n) =>
                        n.userEmail.toLowerCase() === currentUser.email.toLowerCase()
                          ? { ...n, read: true }
                          : n
                      )
                    );
                  }}
                  className="p-2 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-200 relative"
                >
                  <Bell className="w-5 h-5" />
                  {unreadCount > 0 && (
                    <span className="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-red-500 text-white text-[10px] font-bold flex items-center justify-center animate-bounce">
                      {unreadCount}
                    </span>
                  )}
                </button>

                {showNotifDropdown && (
                  <div className="absolute right-0 mt-2 w-80 bg-white text-slate-900 rounded-2xl shadow-2xl border border-slate-200 p-4 z-50">
                    <div className="flex items-center justify-between pb-2 mb-2 border-b border-slate-100">
                      <span className="font-bold text-sm">Notifications</span>
                      <button onClick={() => setShowNotifDropdown(false)}>
                        <X className="w-4 h-4 text-slate-400" />
                      </button>
                    </div>
                    {userNotifications.length === 0 ? (
                      <p className="text-xs text-slate-500 py-4 text-center">No notifications yet.</p>
                    ) : (
                      <div className="space-y-2 max-h-64 overflow-y-auto">
                        {userNotifications.map((n) => (
                          <div
                            key={n.id}
                            className={`p-2.5 rounded-xl border ${
                              n.type === 'warning'
                                ? 'bg-amber-50 border-amber-200'
                                : 'bg-purple-50 border-purple-100'
                            }`}
                          >
                            <p
                              className={`text-xs font-bold ${
                                n.type === 'warning' ? 'text-amber-900' : 'text-purple-900'
                              }`}
                            >
                              {n.title}
                            </p>
                            <p className="text-xs text-slate-700 mt-1">{n.message}</p>
                            <span className="text-[10px] text-slate-400 mt-1 block">{n.createdAt}</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </div>
            )}

            {/* User Profile Button with GLOWING PURPLE CIRCLE when PRO */}
            {currentUser ? (
              <button
                onClick={() => setActiveTab('profile')}
                className="flex items-center gap-2.5 bg-slate-900 hover:bg-slate-800 px-3 py-1.5 rounded-full border border-slate-700 transition"
              >
                <div className="relative">
                  <div
                    className={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm ${
                      currentUser.isPro
                        ? 'bg-purple-700 text-white ring-2 ring-purple-400 shadow-[0_0_16px_rgba(168,85,247,0.95)]'
                        : 'bg-blue-600 text-white'
                    }`}
                  >
                    {currentUser.name.charAt(0).toUpperCase()}
                  </div>
                  {currentUser.isPro && (
                    <span className="absolute -bottom-1.5 -right-2 bg-purple-600 text-white text-[9px] font-extrabold px-1.5 py-0.2 rounded-full border border-white shadow">
                      PRO
                    </span>
                  )}
                </div>
                <div className="hidden lg:block text-left">
                  <p className="text-xs font-semibold text-white leading-none">{currentUser.name}</p>
                  <p className="text-[10px] text-slate-400 mt-0.5">
                    {currentUser.isPro
                      ? `PRO • ${currentUserDaysLeft}d left`
                      : `Free: ${currentUser.applicationsUsed}/5 Applied`}
                  </p>
                </div>
              </button>
            ) : (
              <button
                onClick={() => {
                  setAuthMode('signup');
                  setShowAuthModal(true);
                }}
                className="bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold px-4 py-2 rounded-xl transition shadow"
              >
                Sign Up / Login
              </button>
            )}
          </div>
        </div>
      </header>

      {/* ====================================================================
          3-DAY EXPIRATION TOP BANNER FOR PRO USERS WITH <= 3 DAYS LEFT
      ==================================================================== */}
      {currentUser?.isPro && currentUserDaysLeft <= 3 && (
        <div className="bg-amber-500 text-slate-950 px-4 py-2.5 text-xs font-bold flex flex-wrap items-center justify-center gap-3 shadow">
          <span className="flex items-center gap-1.5">
            <AlertTriangle className="w-4 h-4" />
            Your EUROJOB PRO membership expires in {currentUserDaysLeft} day{currentUserDaysLeft === 1 ? '' : 's'}! Activate/renew now to keep unlimited applications & your Purple PRO status.
          </span>
          <button
            onClick={() => {
              setPaySubmittedSuccess(false);
              setShowUpgradeModal(true);
            }}
            className="bg-slate-950 text-white px-3 py-1 rounded-lg hover:bg-slate-800 transition"
          >
            Renew PRO Now ($5/mo)
          </button>
        </div>
      )}

      {/* ====================================================================
          CONGRATULATIONS MODAL WHEN ADMIN UPGRADES USER TO PRO
      ==================================================================== */}
      {currentUser?.showCongratsModal && (
        <div className="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-md w-full p-7 text-center shadow-2xl border-2 border-purple-500 relative overflow-hidden">
            <div className="w-16 h-16 mx-auto rounded-full bg-purple-100 text-purple-600 flex items-center justify-center ring-4 ring-purple-400 shadow-[0_0_25px_rgba(168,85,247,0.7)] mb-4">
              <Crown className="w-8 h-8" />
            </div>
            <span className="inline-block bg-purple-600 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
              EUROJOB PRO ACTIVATED (30 DAYS)
            </span>
            <h2 className="text-2xl font-extrabold text-slate-900">
              Congratulations, {currentUser.name}!
            </h2>
            <p className="text-sm text-slate-600 mt-2">
              Your PRO membership is now active for <strong>30 days</strong>! Your profile glows with the Purple PRO badge and all premium European career tools are unlocked:
            </p>
            <ul className="text-left text-xs text-slate-700 bg-purple-50 rounded-2xl p-4 mt-4 space-y-2 border border-purple-100">
              <li className="flex items-center gap-2 font-semibold">
                <CheckCircle2 className="w-4 h-4 text-purple-600" /> Unlimited European Job Applications
              </li>
              <li className="flex items-center gap-2 font-semibold">
                <CheckCircle2 className="w-4 h-4 text-purple-600" /> Real-Time AI Acceptance % Score on Every Job
              </li>
              <li className="flex items-center gap-2 font-semibold">
                <CheckCircle2 className="w-4 h-4 text-purple-600" /> Europass Resume PDF & Auto Cover Letter Builder
              </li>
            </ul>
            <button
              onClick={() =>
                setUsers((prev) =>
                  prev.map((u) =>
                    u.email === currentUser.email ? { ...u, showCongratsModal: false } : u
                  )
                )
              }
              className="mt-6 w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-xl shadow-lg transition"
            >
              Start Applying with PRO
            </button>
          </div>
        </div>
      )}

      {/* ====================================================================
          TAB 1: EUROPEAN JOB BOARD (5,000+ PAGINATED VERIFIED JOBS)
      ==================================================================== */}
      {activeTab === 'jobs' && (
        <>
          <section className="bg-gradient-to-b from-[#0F172A] via-[#1E3A8A] to-blue-800 text-white py-12 px-4">
            <div className="max-w-6xl mx-auto text-center">
              <div className="inline-flex items-center gap-2 bg-blue-950/70 border border-blue-400/30 px-4 py-1.5 rounded-full text-xs font-semibold text-blue-200 mb-4">
                <ShieldCheck className="w-4 h-4 text-emerald-400" />
                {jobs.length.toLocaleString()} Verified European Opportunities for Asian Applicants
              </div>
              <h1 className="text-3xl sm:text-5xl font-extrabold tracking-tight">
                Your Verified Gateway to <span className="text-blue-300">European Careers</span>
              </h1>
              <p className="text-blue-100 max-w-2xl mx-auto mt-3 text-sm sm:text-base">
                Direct visa-sponsored roles across Germany, France, Netherlands, Serbia, Malta, Lithuania, Georgia, Armenia, Czech Republic, Norway, Finland & Switzerland.
              </p>

              {/* Search Bar */}
              <div className="mt-7 bg-white p-2 rounded-2xl shadow-xl max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-2 text-slate-900">
                <div className="md:col-span-5 flex items-center px-3 py-2 border-b md:border-b-0 md:border-r border-slate-200">
                  <Search className="w-5 h-5 text-slate-400 mr-2" />
                  <input
                    type="text"
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    placeholder="Job title (e.g. Truck Driver, Welder, React)..."
                    className="w-full text-sm focus:outline-none"
                  />
                </div>
                <div className="md:col-span-3 px-3 py-2 border-b md:border-b-0 md:border-r border-slate-200">
                  <select
                    value={selectedCountry}
                    onChange={(e) => setSelectedCountry(e.target.value)}
                    className="w-full text-sm font-medium bg-transparent focus:outline-none"
                  >
                    {TARGET_COUNTRIES.map((c) => (
                      <option key={c} value={c}>
                        {c}
                      </option>
                    ))}
                  </select>
                </div>
                <div className="md:col-span-4 flex gap-2">
                  <select
                    value={selectedCategory}
                    onChange={(e) => setSelectedCategory(e.target.value)}
                    className="w-full text-sm font-medium bg-transparent px-2 focus:outline-none"
                  >
                    <option value="All Categories">All 4 Job Groups</option>
                    <option value="Tech & IT">Tech & IT</option>
                    <option value="Truck & Logistics">Truck & Logistics</option>
                    <option value="General Labor & Construction">General Labor & Construction</option>
                    <option value="Agriculture & Farming">Agriculture & Farming</option>
                  </select>
                </div>
              </div>

              {/* Country Quick Chips */}
              <div className="flex flex-wrap justify-center gap-2 mt-5">
                {TARGET_COUNTRIES.slice(1).map((country) => (
                  <button
                    key={country}
                    onClick={() => setSelectedCountry(selectedCountry === country ? 'All Countries' : country)}
                    className={`text-xs px-3 py-1 rounded-full border transition ${
                      selectedCountry === country
                        ? 'bg-white text-blue-900 font-bold border-white'
                        : 'bg-blue-950/50 text-blue-100 border-blue-400/30 hover:bg-blue-800'
                    }`}
                  >
                    {country}
                  </button>
                ))}
              </div>
            </div>
          </section>

          <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div className="flex flex-wrap items-center justify-between gap-4 mb-6">
              <div>
                <h2 className="text-xl font-bold text-slate-900">
                  {filteredJobs.length.toLocaleString()} Verified European Jobs Available (Page {currentPage} of {totalPages})
                </h2>
                <p className="text-xs text-slate-500">
                  Aggregated from Arbeitnow EU API, Jooble EU, Adzuna Europe & Direct Verified Employers
                </p>
              </div>
              <button
                onClick={syncLiveEuropeanJobs}
                disabled={isSyncingApi}
                className="flex items-center gap-2 bg-white hover:bg-slate-100 text-blue-800 border border-blue-200 px-4 py-2 rounded-xl text-xs font-bold shadow-sm transition"
              >
                <RefreshCw className={`w-4 h-4 ${isSyncingApi ? 'animate-spin' : ''}`} />
                {isSyncingApi ? 'Fetching Multi-Page Live EU Jobs...' : 'Sync Live Multi-Page API Jobs'}
              </button>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
              {/* Left Job List + Pagination */}
              <div className="lg:col-span-5 space-y-3">
                <div className="space-y-3 max-h-[780px] overflow-y-auto pr-1">
                  {paginatedJobs.map((job) => {
                    const isSelected = selectedJob?.id === job.id;
                    const alreadyApplied = currentUser?.appliedJobIds.includes(job.id);
                    return (
                      <div
                        key={job.id}
                        onClick={() => setSelectedJob(job)}
                        className={`p-4 rounded-2xl border cursor-pointer transition bg-white ${
                          isSelected
                            ? 'border-blue-600 ring-2 ring-blue-100 shadow-md'
                            : 'border-slate-200 hover:border-blue-300'
                        }`}
                      >
                        <div className="flex items-start justify-between gap-2">
                          <div>
                            <span className="inline-block text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 mb-1.5">
                              {job.category}
                            </span>
                            <h3 className="font-bold text-slate-900 text-base leading-snug">{job.title}</h3>
                            <p className="text-xs text-slate-600 mt-0.5 font-medium">{job.company}</p>
                          </div>
                          {alreadyApplied && (
                            <span className="text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-full">
                              Applied ✓
                            </span>
                          )}
                        </div>

                        <div className="flex flex-wrap items-center gap-3 mt-3 text-xs text-slate-600">
                          <span className="flex items-center gap-1 font-semibold text-slate-800">
                            <MapPin className="w-3.5 h-3.5 text-blue-600" />
                            {job.city}, {job.country}
                          </span>
                          <span className="flex items-center gap-1 text-emerald-700 font-semibold">
                            <DollarSign className="w-3.5 h-3.5" />
                            {job.salary}
                          </span>
                        </div>

                        <div className="flex items-center justify-between mt-3 pt-2.5 border-t border-slate-100 text-[11px] text-slate-400">
                          <span className="text-emerald-600 font-semibold flex items-center gap-1">
                            <ShieldCheck className="w-3.5 h-3.5" /> Visa Sponsorship
                          </span>
                          <span>{job.source} • {job.postedAt}</span>
                        </div>
                      </div>
                    );
                  })}
                </div>

                {/* Pagination Bar */}
                <div className="flex items-center justify-between bg-white px-4 py-3 rounded-2xl border border-slate-200 text-xs">
                  <button
                    onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}
                    disabled={currentPage === 1}
                    className="flex items-center gap-1 font-bold text-blue-700 disabled:text-slate-300"
                  >
                    <ChevronLeft className="w-4 h-4" /> Previous
                  </button>
                  <span className="font-semibold text-slate-600">
                    Page {currentPage} of {totalPages}
                  </span>
                  <button
                    onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}
                    disabled={currentPage === totalPages}
                    className="flex items-center gap-1 font-bold text-blue-700 disabled:text-slate-300"
                  >
                    Next <ChevronRight className="w-4 h-4" />
                  </button>
                </div>
              </div>

              {/* Right Job Details */}
              <div className="lg:col-span-7">
                {selectedJob && (
                  <div className="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm sticky top-20">
                    <div className="flex flex-wrap items-start justify-between gap-4 pb-5 border-b border-slate-100">
                      <div>
                        <div className="flex items-center gap-2 mb-2">
                          <span className="text-xs font-bold bg-blue-900 text-white px-3 py-1 rounded-full">
                            {selectedJob.country}
                          </span>
                          <span className="text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1 rounded-full">
                            Verified Visa Sponsor
                          </span>
                        </div>
                        <h2 className="text-2xl font-extrabold text-slate-900">{selectedJob.title}</h2>
                        <p className="text-sm text-slate-600 mt-1 flex items-center gap-2">
                          <Building2 className="w-4 h-4 text-blue-600" />
                          {selectedJob.company} — {selectedJob.city}, {selectedJob.country}
                        </p>
                      </div>
                      <div className="text-right">
                        <p className="text-lg font-extrabold text-blue-800">{selectedJob.salary}</p>
                        <p className="text-xs text-slate-400">{selectedJob.category}</p>
                      </div>
                    </div>

                    {/* AI ACCEPTANCE PERCENTAGE CARD */}
                    <div className="my-5 p-4 rounded-2xl border border-purple-200 bg-gradient-to-r from-purple-50 to-blue-50">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-2">
                          <Sparkles className="w-5 h-5 text-purple-600" />
                          <span className="font-bold text-sm text-slate-900">
                            AI Profile & Document Acceptance Match
                          </span>
                        </div>
                        {currentUser?.isPro ? (
                          <span className="bg-purple-600 text-white text-sm font-extrabold px-3 py-1 rounded-full shadow">
                            {calculateAcceptanceScore(currentUser, selectedJob)}% Acceptance Chance
                          </span>
                        ) : (
                          <button
                            onClick={() => {
                              setPaySubmittedSuccess(false);
                              setShowUpgradeModal(true);
                            }}
                            className="flex items-center gap-1 bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold px-3 py-1.5 rounded-full transition"
                          >
                            <Lock className="w-3.5 h-3.5" /> Unlock % Score (Pro $5/mo)
                          </button>
                        )}
                      </div>

                      {currentUser?.isPro ? (
                        <p className="text-xs text-slate-700 mt-2">
                          Based on your <strong>{currentUser.nationality}</strong> nationality,{' '}
                          <strong>{currentUser.experienceYears} yrs experience</strong>, and verified Passport/Trade credentials, your profile strongly aligns with {selectedJob.country} work permit requirements.
                        </p>
                      ) : (
                        <p className="text-xs text-slate-500 mt-1.5 blur-[2px] select-none">
                          Based on your passport, trade certificate, and experience, your estimated acceptance score is 89% for this European employer.
                        </p>
                      )}
                    </div>

                    <div className="space-y-4">
                      <div>
                        <h4 className="font-bold text-sm text-slate-900 mb-1.5">Role Description</h4>
                        <p className="text-sm text-slate-600 leading-relaxed">{selectedJob.description}</p>
                      </div>

                      <div>
                        <h4 className="font-bold text-sm text-slate-900 mb-2">Applicant Requirements</h4>
                        <ul className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          {selectedJob.requirements.map((req, i) => (
                            <li key={i} className="flex items-center gap-2 text-xs text-slate-700 bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                              <CheckCircle2 className="w-4 h-4 text-blue-600 shrink-0" />
                              {req}
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div className="mt-7 pt-5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
                      <div className="text-xs text-slate-500">
                        {currentUser ? (
                          currentUser.isPro ? (
                            <span className="text-purple-700 font-bold">
                              PRO Member: Unlimited Applications Active ({currentUserDaysLeft} days remaining)
                            </span>
                          ) : (
                            <span>
                              Free Plan: <strong>{currentUser.applicationsUsed} / 5</strong> free applications used
                            </span>
                          )
                        ) : (
                          <span>Sign up free with Google or Email to apply (5 free applications)</span>
                        )}
                      </div>

                      <div className="flex items-center gap-3">
                        <button
                          onClick={() => {
                            setStudioJobId(selectedJob.id);
                            setActiveTab('career-studio');
                          }}
                          className="px-4 py-2.5 rounded-xl border border-blue-200 text-blue-800 hover:bg-blue-50 text-xs font-bold transition"
                        >
                          Generate Europass CV & Letter
                        </button>

                        <button
                          onClick={() => handleApplyJob(selectedJob)}
                          disabled={currentUser?.appliedJobIds.includes(selectedJob.id)}
                          className={`px-6 py-2.5 rounded-xl text-sm font-bold text-white shadow-md transition ${
                            currentUser?.appliedJobIds.includes(selectedJob.id)
                              ? 'bg-emerald-600 cursor-default'
                              : 'bg-blue-700 hover:bg-blue-800'
                          }`}
                        >
                          {currentUser?.appliedJobIds.includes(selectedJob.id)
                            ? 'Application Submitted ✓'
                            : 'Apply Now'}
                        </button>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </main>
        </>
      )}

      {/* ====================================================================
          TAB 2: INTERACTIVE EUROPASS RESUME PDF & COVER LETTER BUILDER (PRO)
      ==================================================================== */}
      {activeTab === 'career-studio' && (
        <section className="max-w-6xl mx-auto px-4 py-10">
          <div className="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
            <div className="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-100">
              <div>
                <span className="text-xs font-extrabold uppercase tracking-wider text-purple-600">
                  EUROJOB PRO Career Toolkit
                </span>
                <h2 className="text-2xl font-extrabold text-slate-900 mt-1">
                  Europass Resume PDF & Company-Specific Cover Letter Builder
                </h2>
                <p className="text-xs text-slate-500 mt-0.5">
                  Fill in your personal, passport, education, and address details below to generate a printable European PDF Resume and a custom Cover Letter addressed to your target employer.
                </p>
              </div>
              <div className="w-full sm:w-auto">
                <label className="block text-[11px] font-bold text-slate-500 mb-1">
                  Target Company & Position:
                </label>
                <select
                  value={studioJobId}
                  onChange={(e) => setStudioJobId(e.target.value)}
                  className="w-full border border-blue-300 bg-blue-50/50 text-blue-950 rounded-xl px-3.5 py-2 text-xs font-bold"
                >
                  {jobs.slice(0, 50).map((j) => (
                    <option key={j.id} value={j.id}>
                      {j.company} — {j.title} ({j.country})
                    </option>
                  ))}
                </select>
              </div>
            </div>

            {!currentUser?.isPro ? (
              <div className="text-center py-14 px-4">
                <div className="w-14 h-14 mx-auto rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center mb-4">
                  <Lock className="w-7 h-7" />
                </div>
                <h3 className="text-xl font-extrabold text-slate-900">
                  Unlock Professional European Resume PDF & Cover Letter Generator
                </h3>
                <p className="text-sm text-slate-600 max-w-lg mx-auto mt-2">
                  Upgrade to EUROJOB Pro ($5/month) to enter your Name, Passport Number, Date of Birth, Education, and Address, generate a downloadable PDF Europass CV, and auto-create a tailored Cover Letter for the exact company you apply to.
                </p>
                <button
                  onClick={() => {
                    setPaySubmittedSuccess(false);
                    setShowUpgradeModal(true);
                  }}
                  className="mt-6 bg-purple-600 hover:bg-purple-700 text-white font-bold px-6 py-3 rounded-xl shadow-lg transition"
                >
                  Upgrade to Pro ($5/Month)
                </button>
              </div>
            ) : (
              <div className="mt-6 space-y-8">
                {/* STEP 1: CANDIDATE INPUT FORM */}
                <form
                  onSubmit={(e) => {
                    e.preventDefault();
                    setCvGenerated(true);
                  }}
                  className="bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-5"
                >
                  <div className="flex items-center justify-between">
                    <h3 className="font-extrabold text-base text-slate-900 flex items-center gap-2">
                      <FileText className="w-4 h-4 text-blue-700" />
                      1. Enter Your Official Applicant Information
                    </h3>
                    <span className="text-[11px] font-semibold text-purple-700 bg-purple-100 px-2.5 py-0.5 rounded-full">
                      PRO Unlocked
                    </span>
                  </div>

                  {/* Personal & Passport Section */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Full Name (As on Passport) *
                      </label>
                      <input
                        type="text"
                        required
                        value={cvFullName}
                        onChange={(e) => setCvFullName(e.target.value)}
                        placeholder="e.g. Muhammad Bilal Ahmed"
                        className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Email Address *
                      </label>
                      <input
                        type="email"
                        required
                        value={cvEmail}
                        onChange={(e) => setCvEmail(e.target.value)}
                        placeholder="you@gmail.com"
                        className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Phone / WhatsApp (with Country Code) *
                      </label>
                      <input
                        type="text"
                        required
                        value={cvPhone}
                        onChange={(e) => setCvPhone(e.target.value)}
                        placeholder="e.g. +92 300 1234567"
                        className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Date of Birth (DOB) *
                      </label>
                      <input
                        type="date"
                        required
                        value={cvDob}
                        onChange={(e) => setCvDob(e.target.value)}
                        className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Passport Number *
                      </label>
                      <input
                        type="text"
                        required
                        value={cvPassportNumber}
                        onChange={(e) => setCvPassportNumber(e.target.value.toUpperCase())}
                        placeholder="e.g. AB1234567"
                        className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white font-mono"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Passport Expiry Date *
                      </label>
                      <input
                        type="date"
                        required
                        value={cvPassportExpiry}
                        onChange={(e) => setCvPassportExpiry(e.target.value)}
                        className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Nationality *
                      </label>
                      <input
                        type="text"
                        required
                        value={cvNationality}
                        onChange={(e) => setCvNationality(e.target.value)}
                        placeholder="e.g. Pakistani / Indian / Nepali"
                        className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white"
                      />
                    </div>

                    <div className="sm:col-span-2">
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Complete Residential Address (Street, City, Postal Code, Country) *
                      </label>
                      <input
                        type="text"
                        required
                        value={cvAddress}
                        onChange={(e) => setCvAddress(e.target.value)}
                        placeholder="e.g. House 14, Block 9, Gulistan-e-Jauhar, Karachi, Pakistan"
                        className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white"
                      />
                    </div>
                  </div>

                  {/* Education, Experience & Skills Sections */}
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Education & Qualifications *
                      </label>
                      <textarea
                        rows={4}
                        required
                        value={cvEducation}
                        onChange={(e) => setCvEducation(e.target.value)}
                        placeholder="e.g. Diploma in Mechanical Engineering (2019)&#10;Higher Secondary Certificate (2017)"
                        className="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-300 bg-white"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Work Experience & Trade History *
                      </label>
                      <textarea
                        rows={4}
                        required
                        value={cvExperience}
                        onChange={(e) => setCvExperience(e.target.value)}
                        placeholder="e.g. Senior Heavy Truck Driver — Al-Futtaim Logistics (2021–2026)&#10;• Operated 40-ton trailers across GCC highways&#10;• Zero accident record & customs compliance"
                        className="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-300 bg-white"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        Skills, Licenses & Languages *
                      </label>
                      <textarea
                        rows={4}
                        required
                        value={cvSkillsAndLanguages}
                        onChange={(e) => setCvSkillsAndLanguages(e.target.value)}
                        placeholder="e.g. Valid HTV / CE Heavy Driving License&#10;English (B1 Intermediate), Urdu/Hindi (Native)&#10;EU Safety & Cold-Chain Handling"
                        className="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-300 bg-white"
                      />
                    </div>
                  </div>

                  <div className="flex flex-wrap items-center justify-between gap-4 pt-2">
                    <p className="text-xs text-slate-500">
                      Cover letter will automatically address{' '}
                      <strong className="text-blue-900">{selectedStudioJob.company}</strong> for the{' '}
                      <strong className="text-blue-900">{selectedStudioJob.title}</strong> role in{' '}
                      <strong>{selectedStudioJob.country}</strong>.
                    </p>
                    <button
                      type="submit"
                      className="bg-gradient-to-r from-blue-700 to-purple-700 hover:from-blue-800 hover:to-purple-800 text-white font-extrabold px-6 py-3 rounded-xl shadow-lg text-sm flex items-center gap-2 transition"
                    >
                      <Sparkles className="w-4 h-4" />
                      Generate PDF Resume & Cover Letter
                    </button>
                  </div>
                </form>

                {/* STEP 2: GENERATED EUROPASS RESUME & AUTO COVER LETTER WITH PDF EXPORT */}
                {cvGenerated && (
                  <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    {/* DOCUMENT A: EUROPASS CURRICULUM VITAE */}
                    <div className="border border-slate-300 rounded-2xl overflow-hidden bg-white shadow-sm flex flex-col">
                      <div className="bg-[#0F172A] text-white px-4 py-3 flex items-center justify-between">
                        <span className="text-xs font-extrabold tracking-wide">
                          EUROPASS CURRICULUM VITAE
                        </span>
                        <button
                          type="button"
                          onClick={() =>
                            handleDownloadPdf(`${cvFullName} - Europass CV`, 'printable-resume')
                          }
                          className="bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow transition"
                        >
                          <Printer className="w-3.5 h-3.5" />
                          Download PDF
                        </button>
                      </div>

                      <div id="printable-resume" className="p-6 text-xs text-slate-800 space-y-4">
                        <div className="header border-b-2 border-blue-900 pb-3">
                          <div>
                            <div className="brand text-[10px] font-extrabold text-blue-700 uppercase tracking-widest">
                              European Standard Curriculum Vitae
                            </div>
                            <h1 className="text-xl font-extrabold text-slate-900 mt-0.5">
                              {cvFullName}
                            </h1>
                            <p className="text-xs font-semibold text-blue-800">
                              Applying for: {selectedStudioJob.title} ({selectedStudioJob.country})
                            </p>
                          </div>
                        </div>

                        <div>
                          <h2 className="text-xs font-extrabold uppercase text-blue-900 border-b border-slate-200 pb-1 mb-2">
                            Personal & Passport Information
                          </h2>
                          <div className="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                            <p><strong>Email:</strong> {cvEmail}</p>
                            <p><strong>Phone / WhatsApp:</strong> {cvPhone}</p>
                            <p><strong>Date of Birth:</strong> {cvDob}</p>
                            <p><strong>Nationality:</strong> {cvNationality}</p>
                            <p><strong>Passport Number:</strong> {cvPassportNumber}</p>
                            <p><strong>Passport Expiry:</strong> {cvPassportExpiry}</p>
                            <p className="sm:col-span-2"><strong>Address:</strong> {cvAddress}</p>
                          </div>
                        </div>

                        <div>
                          <h2 className="text-xs font-extrabold uppercase text-blue-900 border-b border-slate-200 pb-1 mb-2">
                            Work Experience & Trade Background
                          </h2>
                          <p className="whitespace-pre-line leading-relaxed">{cvExperience}</p>
                        </div>

                        <div>
                          <h2 className="text-xs font-extrabold uppercase text-blue-900 border-b border-slate-200 pb-1 mb-2">
                            Education & Qualifications
                          </h2>
                          <p className="whitespace-pre-line leading-relaxed">{cvEducation}</p>
                        </div>

                        <div>
                          <h2 className="text-xs font-extrabold uppercase text-blue-900 border-b border-slate-200 pb-1 mb-2">
                            Skills, Licenses & Languages
                          </h2>
                          <p className="whitespace-pre-line leading-relaxed">{cvSkillsAndLanguages}</p>
                        </div>
                      </div>
                    </div>

                    {/* DOCUMENT B: TAILORED COVER LETTER FOR TARGET COMPANY & POSITION */}
                    <div className="border border-slate-300 rounded-2xl overflow-hidden bg-white shadow-sm flex flex-col">
                      <div className="bg-[#1E3A8A] text-white px-4 py-3 flex items-center justify-between">
                        <span className="text-xs font-extrabold tracking-wide">
                          COVER LETTER — {selectedStudioJob.company.toUpperCase()}
                        </span>
                        <button
                          type="button"
                          onClick={() =>
                            handleDownloadPdf(
                              `${cvFullName} - Cover Letter (${selectedStudioJob.company})`,
                              'printable-cover-letter'
                            )
                          }
                          className="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow transition"
                        >
                          <Printer className="w-3.5 h-3.5" />
                          Download PDF
                        </button>
                      </div>

                      <div id="printable-cover-letter" className="p-6 text-xs text-slate-800 space-y-4">
                        <div className="header border-b-2 border-blue-900 pb-3">
                          <div>
                            <h1 className="text-lg font-extrabold text-slate-900">{cvFullName}</h1>
                            <p className="text-slate-600">{cvAddress}</p>
                            <p className="text-slate-600">
                              {cvEmail} • {cvPhone} • Passport: {cvPassportNumber}
                            </p>
                          </div>
                        </div>

