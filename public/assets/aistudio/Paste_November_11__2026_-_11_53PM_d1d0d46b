type JobCategory = 'Tech & IT' | 'Truck & Logistics' | 'General Labor & Construction' | 'Agriculture & Farming';

interface Job {
  id: string;
  title: string;
  company: string;
  country: string;
  city: string;
  category: JobCategory;
  salary: string;
  visaSponsored: boolean;
  postedAt: string;
  source: 'Arbeitnow API' | 'Jooble EU' | 'Adzuna EU' | 'EUROJOB Verified';
  description: string;
  requirements: string[];
}

interface UserAccount {
  id: string;
  name: string;
  email: string;
  authProvider: 'Google' | 'Email';
  nationality: string;
  trade: JobCategory;
  experienceYears: number;
  skills: string;
  hasPassport: boolean;
  hasLicenseOrCert: boolean;
  isPro: boolean;
  proActivatedAt?: string;
  applicationsUsed: number;
  appliedJobIds: string[];
  showCongratsModal?: boolean;
}

interface PaymentSubmission {
  id: string;
  targetEmail: string;
  method: 'Easypaisa' | 'ACH Bank Transfer';
  transactionId: string;
  screenshotUrl: string;
  submittedAt: string;
  status: 'Pending' | 'Approved' | 'Rejected';
}

interface NotificationItem {
  id: string;
  userEmail: string;
  title: string;
  message: string;
  createdAt: string;
  read: boolean;
}

interface DiscussionPost {
  id: string;
  authorName: string;
  authorIsPro: boolean;
  countryTag: string;
  title: string;
  body: string;
  upvotes: number;
  createdAt: string;
  replies: { id: string; author: string; text: string; isAdmin?: boolean }[];
}

